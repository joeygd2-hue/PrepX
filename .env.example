# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgresql://prepx:prepx@localhost:5432/prepx
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@prep-x.app
PRIVACY_EMAIL=support@prep-x.app
# Comma-separated emails that are promoted to the admin role on sign-in
ADMIN_EMAILS=

# ── Client IP (rate limits) ──
# Reverse proxies in front of the app that each append the caller's address to
# X-Forwarded-For (1 = one proxy such as nginx, Render or a load balancer). Entries
# left of them are client-supplied and ignored. 0 ignores X-Forwarded-For and uses
# X-Real-IP. On Vercel (x-vercel-forwarded-for) and Fly.io (Fly-Client-IP) the
# platform header is used automatically. See docs/DEPLOYMENT.md §2.
TRUSTED_PROXY_COUNT=1
# true = use Cloudflare's CF-Connecting-IP. Only if the origin accepts traffic from Cloudflare alone.
TRUST_CF_CONNECTING_IP=

# ── Google OAuth (optional; button hidden until both are set) ──
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (sign-in codes, parent invites, reminders) ──
# console = write to server log + email_log table (development only)
# resend  = send with Resend (https://resend.com) using RESEND_API_KEY
EMAIL_PROVIDER=console
EMAIL_FROM="PrepX <no-reply@prep-x.app>"
RESEND_API_KEY=

# ── AI (server-side only) ──
# anthropic = Claude via ANTHROPIC_API_KEY; none = AI features show "not configured";
# mock = canned responses for local testing (refused when NODE_ENV=production)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# ── Payments (optional; Pro checkout hidden until configured) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_SEASON_BOOST=

# ── Web push (optional) ── generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Scheduled jobs ── send as "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
